# =============================================================================
# 知研 (zhiyan) 环境变量示例 — 仅声明服务端检索配置(#19)
# =============================================================================
# 使用方法:复制本文件为 .env.local 并填入真实值(git 已忽略 .env* 文件)。
#
# 安全说明(必读):
# - 以下所有键仅在服务端(Node.js API 路由)通过 process.env 读取,
#   绝不会被打包进浏览器代码或通过任何接口返回给浏览器。
# - 不要给这些键加 NEXT_PUBLIC_ 前缀 —— 加了前缀的变量会被打包进
#   客户端代码,导致密钥泄露。
# - 不要把真实密钥提交到 git。本文件只提交键名与说明,不提交密钥值。
# =============================================================================

# 知乎开放平台 Access Secret(服务端鉴权令牌)。
# 用途:启用真实检索(热榜 / 知乎站内搜索 / 全网搜索)的 Bearer 鉴权。
# 未配置或为空时,系统自动降级为确定性演示数据(demo),不会发起任何外部请求。
# 获取方式:知乎开放平台开发者后台。
ZHIHU_ACCESS_SECRET=

# 知乎开放平台 API 基础地址(可选)。
# 用途:覆盖检索 API 的服务端地址;默认 https://developer.zhihu.com。
# 仅在需要代理或镜像时修改;末尾斜杠会被自动去除。
ZHIHU_API_BASE_URL=https://developer.zhihu.com

# =============================================================================
# LLM 诘问服务(OpenAI-compatible,#20)
# =============================================================================
# 用途:配置 LLM_API_KEY 与 LLM_MODEL 后,诘问问题由真实模型按当前策略生成。
# 未配置任一键时,系统自动使用确定性演示生成器(fixture),不发起任何网络请求。
# 失败行为:模型超时、网络错误、空响应、不合规响应(替用户作答/输出裁决/
# 超长/多问)时,最多重试一次,然后回退到策略模板,并在界面标注
# "已使用策略模板"(usedFallback)。策略与轮次始终由程序决定,模型只生成
# 当前策略的追问文本。
#
# 安全说明(必读):
# - 以下键仅在服务端读取,绝不会进入浏览器代码;不要加 NEXT_PUBLIC_ 前缀。
# - 不要把真实密钥提交到 git。本文件只声明键名,不包含任何密钥。
# - 发送给模型的请求只包含:策略指令、所选立场、用户最新回答、报告证据
#   片段(截断)与安全约束;不包含会话 ID、完整历史或来源 URL。

# OpenAI-compatible API 基础地址(可选)。
# 请求地址为 {LLM_BASE_URL}/chat/completions;默认 https://api.openai.com/v1。
# 末尾斜杠会被自动去除。
LLM_BASE_URL=https://api.openai.com/v1

# LLM 服务密钥(与 LLM_MODEL 同时配置才启用真实模型;留空则使用演示生成器)。
LLM_API_KEY=

# 模型名称(与 LLM_API_KEY 同时配置才启用真实模型),例如 gpt-4o-mini。
LLM_MODEL=

# 单次请求超时毫秒数(可选,默认 10000)。
LLM_TIMEOUT_MS=10000

# =============================================================================
# Neon PostgreSQL 持久化(#21)
# =============================================================================
# 用途:配置 DATABASE_URL 后,会话/报告/成果卡/简化画像持久化到 Neon
# PostgreSQL(通过官方 serverless 驱动 @neondatabase/serverless,HTTP 查询)。
# 未配置或为空时,系统保持与基线一致的进程内存储(Memory),不会发起任何
# 外部请求。
#
# 降级行为(验收标准 3):
# - 已配置但连接失败:所有存储操作返回明确的"服务端存储不可用"信号
#   (503 / body storage:'unavailable'),绝不伪称已远端保存;
#   客户端继续使用 localStorage 镜像并在界面展示"仅本地保存"。
#
# 匿名所有权(#21):
# - 客户端在 localStorage 持久化随机 owner id(zhiyan_owner_id),请求通过
#   x-zhiyan-owner 头携带;服务端所有存储查询按 owner_id 隔离。
# - 不同匿名设备的记录互不可见;无注册/登录/OAuth。
#
# 恢复优先级与冲突规则(文档):
# - 服务端可达 → 以服务端为持久候选;服务端不可用 → 本地镜像。
# - 同 id 冲突 → updatedAt 新者胜;时间戳相同 → 服务端(持久方)为准。
# - completed 会话永不覆盖(存储层 SQL WHERE 守卫 + 路由 409)。
#
# 数据库迁移(幂等,可重复执行):
#   DATABASE_URL="postgres://…" npm run db:migrate
# 迁移语句仅含 CREATE TABLE/INDEX IF NOT EXISTS,空库与已迁移库均可重复执行。
#
# 安全说明(必读):
# - 以下键仅在服务端(Node.js API 路由)通过 process.env 读取,绝不会打包进
#   浏览器代码;不要加 NEXT_PUBLIC_ 前缀。
# - 不要把真实连接串提交到 git。本文件只声明键名,不包含任何密钥。
# =============================================================================

# Neon PostgreSQL 连接串(留空则使用进程内存储,不发外部请求)。
# 形如:postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
