# 知研 MVP 的服务端环境变量示例
#
# 使用方式：复制为 .env.local 后填写真实值。不要提交 .env.local。
# 所有密钥只能在服务端使用；不要使用 NEXT_PUBLIC_ 前缀。

# --- 知乎真实检索（#19 接入后使用）---
# 知乎开放平台的服务端访问密钥。留空时使用确定性 demo 数据，且不发外部请求。
ZHIHU_ACCESS_SECRET=

# 可选：知乎检索 API 基础地址。默认实现使用 https://developer.zhihu.com。
ZHIHU_API_BASE_URL=https://developer.zhihu.com

# --- OpenAI-compatible 诘问模型（#20 接入后使用）---
# 同时填写 LLM_API_KEY 和 LLM_MODEL 才会启用真实模型；否则使用本地 fixture/模板降级。
LLM_API_KEY=
LLM_MODEL=

# 可选：兼容 OpenAI Chat Completions 的服务端地址与单次请求超时（毫秒）。
# LLM_BASE_URL=https://example.com/v1
# 不用加chat/completions
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=10000

# --- Neon PostgreSQL 持久化（#21 接入后使用）---
# Neon 连接串。留空时使用本地内存/浏览器 localStorage 降级，不连接数据库。
# 示例：postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
