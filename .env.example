DATABASE_URL=

# Sink short-link service. SINK_API_KEY is the Sink NUXT_SITE_TOKEN.
SINK_BASE_URL=https://your-sink-instance.example
SINK_API_KEY=
# Public URL of this app, used as the target behind Sink short links.
SHARE_BASE_URL=https://your-public-zhiyan-domain.example
# General LLM endpoint (supports DeepSeek, OpenAI, Qwen, etc.).
# Used for interrogation follow-up rounds, report synthesis, and knowledge-graph extraction.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_SYNTHESIS_TIMEOUT_MS=45000
LLM_TIMEOUT_MS=10000

# Optional dedicated endpoint for knowledge-graph extraction (automatically inherits LLM_* when empty).
GRAPH_LLM_API_KEY=
GRAPH_LLM_BASE_URL=
GRAPH_LLM_MODEL=
GRAPH_LLM_TIMEOUT_MS=
# Email verification service:
# Option A (Recommended without custom domain): Use standard SMTP (QQ 邮箱 / 163 邮箱 / Gmail 等个人邮箱)
# For QQ Mail: Set SMTP_USER=your_qq@qq.com, SMTP_PASS=your_authorization_code (QQ邮箱-设置-账户-开启POP3/SMTP生成的授权码)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_FROM=

# Option B: Use Resend API (requires verified custom domain at https://resend.com/domains for sending to any recipient)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Zhihu OAuth (server-side only). Use a public HTTPS callback that exactly matches the Zhihu registration.
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=
# Access Secret is also required when an authorized user explicitly requests creations, follows, or favorites.
ZHIHU_ACCESS_SECRET=
ZHIHU_API_BASE_URL=