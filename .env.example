# Copy this file to .env.local for local development. For CloudBase CloudRun,
# add the same variable names in the service's Runtime variables and secrets.
# Never commit .env.local or paste a real secret into this file, Git, or chat.
# Leave an optional variable empty to retain the application's existing fallback behavior.

# -----------------------------------------------------------------------------
# Core providers
# -----------------------------------------------------------------------------
# PostgreSQL connection string. Empty: persistence falls back to localStorage.
DATABASE_URL=

# Real LLM calls require both LLM_API_KEY and LLM_MODEL.
# The URL must be the provider's OpenAI-compatible API base path.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_MS=10000
LLM_SYNTHESIS_TIMEOUT_MS=45000

# Zhihu public-content provider. Empty ZHIHU_ACCESS_SECRET: fixture fallback.
ZHIHU_ACCESS_SECRET=
ZHIHU_API_BASE_URL=https://developer.zhihu.com

# -----------------------------------------------------------------------------
# Public sharing and optional Sink short links
# -----------------------------------------------------------------------------
# Public HTTPS address of this application, without a trailing slash.
# Example: https://your-app.example.com
SHARE_BASE_URL=

# Both variables are required to create short links. Empty: sharing returns a
# normal long URL. SINK_API_KEY is Sink's NUXT_SITE_TOKEN (not a Cloudflare API token).
SINK_BASE_URL=
SINK_API_KEY=

# -----------------------------------------------------------------------------
# Optional dedicated knowledge-graph LLM
# -----------------------------------------------------------------------------
# Leave all GRAPH_LLM_* variables empty to reuse the general LLM settings above.
GRAPH_LLM_API_KEY=
GRAPH_LLM_BASE_URL=
GRAPH_LLM_MODEL=
GRAPH_LLM_TIMEOUT_MS=

# -----------------------------------------------------------------------------
# Email verification — configure ONE transport
# -----------------------------------------------------------------------------
# Option A: SMTP. SMTP_USER + SMTP_PASS are sufficient for QQ, 163, 126,
# Gmail, and Outlook; host/port/TLS/from are inferred when left empty.
# SMTP_PASS must be the mailbox app password / authorization code, never the
# mailbox sign-in password. If both SMTP and Resend are configured, SMTP wins.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_FROM=

# Option B: Resend. Requires RESEND_API_KEY; production delivery to arbitrary
# recipients also requires a verified sender domain and RESEND_FROM_EMAIL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Optional Zhihu OAuth user authorization
# -----------------------------------------------------------------------------
# The redirect URI must be public HTTPS and exactly match the URI registered
# with Zhihu, e.g. https://your-app.example.com/api/auth/zhihu/callback.
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=

# Do not set PORT or HOSTNAME here: the CloudRun container supplies its fixed
# listener configuration (0.0.0.0:3000).
